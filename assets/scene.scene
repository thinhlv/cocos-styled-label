  {
    "__type__": "CCPropertyOverrideInfo",
    "targetInfo": {
      "__id__": 22
    },
    "propertyPath": [
      "_htmlString"
    ],
    "value": "<color=#FFD700><size=40><b>STYLED LABEL</b></size></color> <color=#AAAAAA><size=18>v1.0</size></color>\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Text Styles ──</b></color>\n  <br/>\n  Normal  <b>Bold</b>  <i>Italic</i>  <u>Underline</u>  <b><i>Bold+Italic</i></b>  <b><i><u>All three</u></i></b>\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Colors ──</b></color>\n  <br/>\n  <color=#FF4444>Red</color>  <color=#44FF44>Green</color>  <color=#4488FF>Blue</color>  <color=#FFD700>Gold</color>  <color=#FF88FF>Pink</color>\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Sizes ──</b></color>\n  <br/>\n  <size=16>tiny</size>  <size=20>small</size>  <size=24>normal</size>  <size=32>large</size>  <size=40>huge</size>\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Vertical Align ──</b></color>\n  <br/>\n  <sup><size=16><color=#FFD700>$</color></size></sup><size=32>2,000</size>   <size=32>100</size><sub><size=16><color=#88FFFF>mg</color></size></sub>   H<sub><size=16>2</size></sub>O\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Sprites (Emoji 0–15) ──</b></color>\n  <br/>\n  <sprite=0><sprite=1><sprite=2><sprite=3><sprite=4><sprite=5><sprite=6><sprite=7>\n  <br/>\n  <sprite=8><sprite=9><sprite=10><sprite=11><sprite=12><sprite=13><sprite=14><sprite=15>\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Sprite with custom size ──</b></color>\n  <br/>\n  <sprite=0 size=16> small  <sprite=0 size=24> medium  <sprite=0 size=40> large\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Mixed inline ──</b></color>\n  <br/>\n  Score: <sprite=3 size=24><color=#FFD700><b>9,999</b></color>  HP: <sprite=7 size=24><color=#FF4444><b>100%</b></color>\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Click event ──</b></color>\n  <br/>\n  <color=#44AAFF><u><on click=\"openShop\" param=\"gold\">Tap here to open shop</on></u></color>\n  <br/>\n  <br/>\n  <color=#FFFFFF><b>── Entities ──</b></color>\n  <br/>\n\n<u>All three</u> xin chào. <sprite=0>. hello"
  },
